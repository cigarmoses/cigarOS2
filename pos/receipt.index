<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Invoice</title>
  <style>
    :root {
      --ink: #ffffff;
      --blue: #2da3ff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #000;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
      color: var(--ink);
    }

    /* top bar like your screenshot */
    .top-bar {
      height: 70px;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 18px;
    }
    .top-left {
      font-size: 30px;
      line-height: 1;
      cursor: pointer;
    }
    .top-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .dot {
      width: 8px;
      height: 8px;
      background: #ff9d00;
      border-radius: 999px;
    }
    .menu-dots {
      width: 4px;
      height: 4px;
      border-radius: 999px;
      background: #fff;
      box-shadow: 0 7px 0 #fff, 0 -7px 0 #fff;
    }

    /* main sheet */
    .sheet {
      background: #121820;
      border-top-left-radius: 26px;
      border-top-right-radius: 26px;
      padding: 30px 20px 120px;
      min-height: calc(100vh - 70px);
    }

    .title {
      text-align: center;
      font-size: 26px;
      font-weight: 500;
      letter-spacing: 0.04em;
      margin-bottom: 8px;
    }
    .date-line {
      text-align: center;
      font-size: 14px;
      color: rgba(255,255,255,.7);
      margin-bottom: 18px;
    }

    /* line items */
    .item {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 15px;
    }
    .item-icon {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      overflow: hidden;
      background: #1f2428;
      flex: 0 0 58px;
      display: grid;
      place-items: center;
    }
    .item-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .item-body {
      flex: 1;
      min-width: 0;
    }
    .item-title {
      font-size: 17px;
      font-weight: 600;
      color: #38a8ff;
      margin-bottom: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .item-sub {
      font-size: 13px;
      color: rgba(255,255,255,.65);
      line-height: 1.25;
    }
    .item-sub:last-child { margin-top: 3px; }

    .item-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .qty-pill {
      background: rgba(11,12,13,0.4);
      border-radius: 999px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 8px;
    }
    .qty-pill button {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.2);
      background: transparent;
      color: #fff;
      font-size: 16px;
      line-height: 1;
      display: grid;
      place-items: center;
      cursor: pointer;
    }
    .qty-pill span {
      min-width: 16px;
      text-align: center;
      font-weight: 500;
    }
    .price-pill {
      background: #194b66;
      border-radius: 999px;
      padding: 9px 18px 9px 16px;
      font-weight: 600;
      font-size: 17px;
    }

    /* totals */
    .totals {
      margin-top: 26px;
      border-top: 1px solid rgba(255,255,255,.05);
      padding-top: 18px;
      max-width: 320px;
      margin-left: auto;
    }
    .totals-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
      font-size: 16px;
      letter-spacing: 0.03em;
    }
    .totals-row:last-child {
      margin-top: 10px;
      font-size: 20px;
      font-weight: 600;
    }

    @media (min-width: 520px) {
      .sheet {
        max-width: 460px;
        margin: 0 auto;
      }
    }
  </style>
</head>
<body>

  <!-- top bar -->
  <div class="top-bar">
    <!-- this calls the parent page to close the modal -->
    <div class="top-left" onclick="if (window.parent && window.parent.closeBill) window.parent.closeBill();">×</div>
    <div class="top-right">
      <div class="dot"></div>
      <div class="menu-dots"></div>
    </div>
  </div>

  <!-- invoice sheet -->
  <div class="sheet">
    <div class="title">INVOICE</div>
    <div class="date-line" id="invDate">Thursday, 10/23/25 — 11:02 PM</div>

    <!-- ITEM 1 -->
    <div class="item">
      <div class="item-icon">
        <img src="/img/icons/brands/fatbottombetty.svg" alt="Fat Bottom Betty">
      </div>
      <div class="item-body">
        <div class="item-title">Fat Bottom Betty</div>
        <div class="item-sub">Gordo</div>
        <div class="item-sub">La Flor Dominicana</div>
        <!-- no “MSRP” label per your request -->
        <div class="item-sub">3.99</div>
      </div>
      <div class="item-right">
        <div class="qty-pill">
          <button>-</button>
          <span>1</span>
          <button>+</button>
        </div>
        <div class="price-pill">13.99</div>
      </div>
    </div>

    <!-- ITEM 2 -->
    <div class="item">
      <div class="item-icon">
        <img src="/img/icons/brands/lfd.svg" alt="Andalusian Bull">
      </div>
      <div class="item-body">
        <div class="item-title">Andalusian Bull</div>
        <div class="item-sub">Figurado</div>
        <div class="item-sub">La Flor Dominicana</div>
        <div class="item-sub">32.00</div>
      </div>
      <div class="item-right">
        <div class="qty-pill">
          <button>-</button>
          <span>2</span>
          <button>+</button>
        </div>
        <div class="price-pill">64.00</div>
      </div>
    </div>

    <!-- totals -->
    <div class="totals">
      <div class="totals-row">
        <span>SUBTOTAL</span>
        <span id="subTotal">77.99</span>
      </div>
      <div class="totals-row">
        <span>TAX</span>
        <span id="taxTotal">5.46</span>
      </div>
      <div class="totals-row">
        <span>TOTAL</span>
        <span id="grandTotal">83.45</span>
      </div>
    </div>
  </div>

  <script>
    // put current date/time at top
    const d = new Date();
    const dayName = d.toLocaleDateString(undefined, { weekday: "long" });
    const dateStr = d.toLocaleDateString(undefined, { month: "2-digit", day: "2-digit", year: "2-digit" });
    const timeStr = d.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" });
    document.getElementById("invDate").textContent = `${dayName}, ${dateStr} — ${timeStr}`;
  </script>
</body>
</html>
